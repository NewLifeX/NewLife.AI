<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AssemblyName>ChatAI</AssemblyName>
    <AssemblyTitle>多模态AI对话与网关</AssemblyTitle>
    <Description>集对话前端、统一 AI 网关、Agent 平台于一身的完整 AI 应用。支持多轮对话、流式输出、函数调用、图像生成、会话管理与使用量统计</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 NewLife</Copyright>
    <VersionPrefix>1.7</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin\Web</OutputPath>
    <!--<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>-->
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>..\Doc\newlife.snk</AssemblyOriginatorKeyFile>
    <NoWarn>1701;1702;NU5104;NETSDK1138;CS7035;NETSDK1022</NoWarn>
    <!--<EnableDefaultContentItems>false</EnableDefaultContentItems>-->
  </PropertyGroup>
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>NewLife.ChatAI</PackageId>
    <Authors>$(Company)</Authors>
    <PackageProjectUrl>https://ai.newlifex.com</PackageProjectUrl>
    <PackageIcon>leaf.png</PackageIcon>
    <RepositoryUrl>https://github.com/NewLifeX/NewLife.AI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>新生命团队;AI;NewLife;$(AssemblyName)</PackageTags>
    <PackageReleaseNotes>31 种运行时语言与前端 11 语种，修正阿拉伯语等 RTL 布局；网关新增按密钥能力开关与限流作用域；自学习支持用户级开关；新增 MessageStore 统一消息落库，思考内容压缩与工具调用分片存储；SSE 消息开始事件携带 UserMessageId；办公文档品牌设计系统与真实汇报风格；发布双通道（GitHub Packages + NuGet.org）</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
    <EmbeddedResource Include="Resources\china-map.svg" />
  </ItemGroup>

  <!-- wwwroot 已嵌入 DLL，移除 NuGet 包中的 staticwebassets/ 目录
       单目标框架走 IncludeStaticWebAssetsPackItems，多目标框架走 CrossTargetingIncludeStaticWebAssets，需同时挂两个目标 -->
  <Target Name="ClearStaticWebAssetsFromPack" AfterTargets="IncludeStaticWebAssetsPackItems;CrossTargetingIncludeStaticWebAssets">
    <ItemGroup>
      <Content Remove="@(_StaticWebAssetsFilesToPack)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <Content Include="..\Doc\leaf.png" Link="leaf.png" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\README.nuget.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- 直接引用 NewLife.Core：PackageReference 默认不传递 analyzers/build，源生成器与 Locales 自动挂载需要直接引用 -->
    <PackageReference Include="NewLife.Core" Version="12.0.2026.1024" />
    <PackageReference Include="NewLife.Cube.Core" Version="6.15.2026.1018-beta1727" />
    <PackageReference Include="NewLife.Holiday" Version="1.5.2026.1024" />
    <PackageReference Include="NewLife.MySql" Version="1.5.2026.1024" />
    <PackageReference Include="NewLife.Office" Version="1.5.2026.1024" />
    <PackageReference Include="NewLife.XCode" Version="12.3.2026.1024" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.AI\NewLife.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>


</Project>
